# Use ./init.ps1 to generate .env with cryptographically random secrets.
LITELLM_PORT=14000
UI_USERNAME=admin
UI_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
LITELLM_MASTER_KEY=sk-REPLACE_WITH_RANDOM_KEY
# Keep this salt together with database backups; do not rotate it casually.
LITELLM_SALT_KEY=REPLACE_WITH_RANDOM_SALT
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
